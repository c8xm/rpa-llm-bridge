# 浏览器
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_BROWSERS_PATH=
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
BROWSER_PROFILE_DIR=.tmp/browser-profile

# 产物与状态
ARTIFACTS_DIR=artifacts
AUDIT_DIR=artifacts/audit
RUNS_DIR=artifacts/runs
RECIPES_DIR=agentrpa/recipes/examples

# 超时与节流
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
ACTION_DELAY_MS=700
MAX_PAGE_TEXT_CHARS=18000

# 策略：白名单与闸门
ALLOWED_DOMAINS=jd.com,360buy.com,taobao.com,tmall.com,pinduoduo.com,yangkeduo.com
ALLOWED_APPS=
ALLOW_STATE_CHANGING_ACTIONS=false
REQUIRE_HITL_FOR_STATE_CHANGES=true
EXTRA_BLOCKED_TERMS=

# 调试
AGENTRPA_DRY_RUN=false
AGENTRPA_DEBUG=false
