# 浏览器
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_BROWSERS_PATH=
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
BROWSER_PROFILE_DIR=.tmp/browser-profile

# 产物与状态
ARTIFACTS_DIR=artifacts
AUDIT_DIR=artifacts/audit
RUNS_DIR=artifacts/runs
RECIPES_DIR=agentrpa/recipes/examples

# 超时与节流
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
ACTION_DELAY_MS=700
MAX_PAGE_TEXT_CHARS=18000

# 策略：白名单与闸门
ALLOWED_DOMAINS=jd.com,360buy.com,taobao.com,tmall.com,pinduoduo.com,yangkeduo.com
ALLOWED_APPS=
ALLOW_STATE_CHANGING_ACTIONS=false
REQUIRE_HITL_FOR_STATE_CHANGES=true
EXTRA_BLOCKED_TERMS=

# 调试
AGENTRPA_DRY_RUN=false
AGENTRPA_DEBUG=false

# ============================================================
# v2.0 桥（agentrpa_bridge）—— 与上面的内核配置互不影响
# ============================================================

# ---- 网关 ----
AGENTRPA_HOST=127.0.0.1
AGENTRPA_PORT=8765
# tenant:token，逗号分隔；生产必须配。v2.2 起 ALLOW_ANON 默认就是 0
AGENTRPA_TOKENS=tenantA:tok-a
AGENTRPA_ALLOW_ANON=0
AGENTRPA_MAX_CONCURRENCY=4
AGENTRPA_QUEUE_TIMEOUT=30
AGENTRPA_RATE_LIMIT=60
AGENTRPA_IDLE_TTL=180
AGENTRPA_AUDIT_DIR=artifacts/audit
AGENTRPA_JOB_TTL=3600
# 同一 Idempotency-Key 的结果缓存多久（秒）；0 = 关闭
AGENTRPA_IDEMPOTENCY_TTL=900
# 限速与幂等的共享后端：memory（单机）| sqlite（同机多进程 / 共享盘）
AGENTRPA_STATE_BACKEND=memory
AGENTRPA_STATE_PATH=artifacts/bridge-state.db

# ---- 后端：Codex（MCP 常驻）----
AGENTRPA_CODEX_CMD=codex
AGENTRPA_CODEX_ARGS=mcp-server
AGENTRPA_CODEX_SANDBOX=workspace-write
AGENTRPA_CODEX_TIMEOUT=600

# ---- 后端：Claude Code（工具面，非问答）----
AGENTRPA_CLAUDE_CMD=claude
AGENTRPA_CLAUDE_ARGS=mcp serve
AGENTRPA_CLAUDE_TOOL=Bash
AGENTRPA_CLAUDE_TIMEOUT=600

# ---- 后端：DeepSeek Harness（dsh headless）----
# 凭据只读启动环境 / <cwd>/.env / $DSH_HOME/.env，不读 GUI 里存的 key
AGENTRPA_DSH_CMD=dsh
AGENTRPA_DSH_ARGS=headless -
# 想要进度事件就把 --json 加进去（网关会按行解析并通过 SSE 推送）
# AGENTRPA_DSH_ARGS=headless --json -
AGENTRPA_DSH_TIMEOUT=900

# ---- 后端：豆包（火山方舟，OpenAI 兼容；model 填接入点 ep-...）----
AGENTRPA_DOUBAO_BASE=https://ark.cn-beijing.volces.com/api/v3
AGENTRPA_DOUBAO_MODEL=
AGENTRPA_DOUBAO_KEY=
AGENTRPA_DOUBAO_TIMEOUT=120

# ---- 后端：通用 OpenAI 兼容（DeepSeek / vLLM / 私有网关）----
AGENTRPA_OPENAI_BASE=https://api.deepseek.com/v1
AGENTRPA_OPENAI_MODEL=deepseek-chat
AGENTRPA_OPENAI_KEY=
AGENTRPA_OPENAI_TIMEOUT=120

# ---- 反向：影刀开放平台 ----
YINGDAO_API_BASE=https://api.yingdao.com
YINGDAO_ACCESS_KEY_ID=
YINGDAO_ACCESS_KEY_SECRET=
# 企业护栏（生产建议全开，详见 docs/ENTERPRISE-ADOPTION.md 第 6 节）
YINGDAO_ALLOWED_APPS=
YINGDAO_APPROVAL_APPS=
YINGDAO_MAX_PER_APP=4
YINGDAO_IDEMPOTENCY_TTL=900
# 没人轮询终态时槽位最多占这么久（秒），超时自动回收，避免全体 busy
YINGDAO_MAX_HOLD=3600
# 本地模式（可选）
YINGDAO_SHADOWBOT=
YINGDAO_USER_FOLDER=
YINGDAO_LAUNCH_ARGS=startapp --app "{app}" --params "{params_json}"

# ---- RPA 工位侧（只给 sdk/rpa_agent_block.py 用）----
AGENTRPA_GATEWAY=http://127.0.0.1:8765
AGENTRPA_TOKEN=tok-a
